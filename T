-- 3. Join Small Server (lowest population)
tabs.Main:AddButton({
    Title = "Join Small Server",
    Callback = function()
        local player = game.Players.LocalPlayer
        if not player then return end

        local TeleportService = game:GetService("TeleportService")
        local HttpService = game:GetService("HttpService")
        local placeId = game.PlaceId
        local currentJobId = game.JobId

        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100"
        local success, result = pcall(function()
            return HttpService:GetAsync(url)
        end)

        if not success then
            warn("Failed to fetch servers. Teleporting to a new instance.")
            TeleportService:Teleport(placeId, player)
            return
        end

        local data = HttpService:JSONDecode(result)
        local servers = data.data

        -- Filter out current server and full servers
        local availableServers = {}
        for _, server in ipairs(servers) do
            if server.id ~= currentJobId and server.playing < server.maxPlayers then
                table.insert(availableServers, server)
            end
        end

        if #availableServers == 0 then
            warn("No other servers available. Teleporting to a new instance.")
            TeleportService:Teleport(placeId, player)
            return
        end

        -- Sort by player count (smallest first)
        table.sort(availableServers, function(a, b)
            return a.playing < b.playing
        end)

        -- Pick the server with the absolute fewest players
        local smallestServer = availableServers[1]
        
        -- OPTIONAL: If you want to avoid completely empty servers (0 players),
        -- you can loop through the sorted list to find one with > 0 players.
        -- Uncomment the lines below if you prefer that:
        local targetServer = smallestServer
        for _, server in ipairs(availableServers) do
            if server.playing > 0 then
                targetServer = server
                break
            end
        end

        TeleportService:TeleportToPlaceInstance(placeId, smallestServer.id, player)
    end
})

