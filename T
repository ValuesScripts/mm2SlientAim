local roles = {}  -- stores GetPlayerData results

local function IsAlive(player)
    for name, info in pairs(roles or {}) do
        if player.Name == name then
            return not info.Killed and not info.Dead
        end
    end
    return false
end

local function clearPlayerEsp(player)
    if not player or not player.Character then return end
    local char = player.Character
    local h = char:FindFirstChild("Highlight")
    if h then h:Destroy() end
    local tag = char:FindFirstChild("EspNameTag")
    if tag then tag:Destroy() end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local box = root:FindFirstChild("BoxESP")
        if box then box:Destroy() end
        local tracer = root:FindFirstChild("TracerESP")
        if tracer then tracer:Destroy() end
    end
end

local function clearEsp()
    for _, player in ipairs(Players:GetPlayers()) do
        clearPlayerEsp(player)
    end
    for gun, _ in pairs(droppedGuns) do
        if gun then
            local highlight = gun:FindFirstChild("GunDropHighlight")
            if highlight then highlight:Destroy() end
        end
    end
end

local function UpdateHighlights()
    if not _G.EspEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            clearPlayerEsp(player)
        end
        return
    end

    -- Fetch roles from server
    local success, data = pcall(function()
        return ReplicatedStorage:FindFirstChild("GetPlayerData", true):InvokeServer()
    end)

    -- Fallback: if server data fails, use old detection
    if not success or not data or next(data) == nil then
        updateRoles()
        local tempMap = {}
        for name, role in pairs(roleCache) do
            tempMap[name] = role
        end
        data = tempMap
        roles = {}
        for name, _ in pairs(roleCache) do
            roles[name] = { Killed = false, Dead = false }
        end
    else
        roles = data
        for name, info in pairs(data) do
            if info.Role then
                roleCache[name] = info.Role
            end
            playerRoleInfo[name] = info
        end
    end

    -- Identify special roles
    local Murder, Sheriff, Hero
    for name, info in pairs(roles) do
        local role = info.Role or info
        if role == "Murderer" then Murder = name
        elseif role == "Sheriff" then Sheriff = name
        elseif role == "Hero" then Hero = name
        end
    end

    -- Update each player
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end

        local role = (roles[player.Name] and roles[player.Name].Role) or roleCache[player.Name]
        if not role then continue end

        local fillColor = Color3.fromRGB(0, 225, 0)  -- Innocent
        if player.Name == Murder and IsAlive(player) then
            fillColor = Color3.fromRGB(225, 0, 0)     -- Red
        elseif player.Name == Sheriff and IsAlive(player) then
            fillColor = Color3.fromRGB(0, 0, 225)     -- Blue
        elseif player.Name == Hero and IsAlive(player) and (not Sheriff or not IsAlive(Players[Sheriff])) then
            fillColor = Color3.fromRGB(255, 250, 0)   -- Yellow
        end

        -- Highlight
        local h = char:FindFirstChild("Highlight")
        if not h then
            h = Instance.new("Highlight")
            h.Name = "Highlight"
            h.Parent = char
        end
        h.FillColor = fillColor
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.OutlineTransparency = 0.3
        h.Enabled = true

        -- Name ESP
        if _G.NamesESP then
            local head = char:FindFirstChild("Head")
            if head then
                local tag = char:FindFirstChild("EspNameTag")
                if not tag then
                    tag = Instance.new("BillboardGui")
                    tag.Name = "EspNameTag"
                    tag.Parent = char
                    tag.AlwaysOnTop = true
                    tag.Size = UDim2.new(0, 200, 0, 50)
                    tag.StudsOffset = Vector3.new(0, 2.5, 0)
                    tag.MaxDistance = 500
                    local label = Instance.new("TextLabel")
                    label.Name = "TextLabel"
                    label.Parent = tag
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextScaled = false
                    label.TextSize = 15
                    label.Font = Enum.Font.SourceSansBold
                    label.TextStrokeTransparency = 0.5
                    label.Text = player.Name
                    label.TextColor3 = fillColor
                else
                    tag.TextLabel.TextColor3 = fillColor
                    tag.TextLabel.Text = player.Name
                end
            end
        else
            local tag = char:FindFirstChild("EspNameTag")
            if tag then tag:Destroy() end
        end

        -- Box ESP
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and _G.BoxESP then
            local boxGui = root:FindFirstChild("BoxESP")
            if not boxGui then
                boxGui = Instance.new("BillboardGui")
                boxGui.Name = "BoxESP"
                boxGui.Parent = root
                boxGui.AlwaysOnTop = true
                boxGui.Size = UDim2.new(0, 60, 0, 80)
                boxGui.StudsOffset = Vector3.new(0, 0, 0)
                local frame = Instance.new("Frame")
                frame.Name = "BoxFrame"
                frame.Parent = boxGui
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundTransparency = 1
                frame.BorderSizePixel = 2
                frame.BorderColor3 = fillColor
            else
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    local height = hum.HipHeight * 2 + 0.5
                    local width = height * 0.4
                    boxGui.Size = UDim2.new(0, width * 3, 0, height * 3)
                    boxGui.BoxFrame.BorderColor3 = fillColor
                end
            end
        else
            if root then
                local box = root:FindFirstChild("BoxESP")
                if box then box:Destroy() end
            end
        end

        -- Tracer ESP
        if root and _G.TracerESP then
            local tracer = root:FindFirstChild("TracerESP")
            if not tracer then
                tracer = Instance.new("BillboardGui")
                tracer.Name = "TracerESP"
                tracer.Parent = root
                tracer.AlwaysOnTop = true
                tracer.Size = UDim2.new(0, 0, 0, 0)   -- no size, we use a frame
                tracer.StudsOffset = Vector3.new(0, 0, 0)

                local line = Instance.new("Frame")
                line.Name = "Line"
                line.Parent = tracer
                line.BackgroundColor3 = fillColor
                line.BorderSizePixel = 0
                line.Size = UDim2.new(0, 2, 0, 200)   -- initial length
                line.Position = UDim2.new(0.5, 0, 0, 0)   -- top center
                line.AnchorPoint = Vector2.new(0.5, 0)    -- anchor at top
                line.BackgroundTransparency = 0.3
                line.Rotation = 0
            else
                local line = tracer:FindFirstChild("Line")
                if line then line.BackgroundColor3 = fillColor end
            end
        else
            if root then
                local tracer = root:FindFirstChild("TracerESP")
                if tracer then tracer:Destroy() end
            end
        end
    end
end

local function UpdateTracers()
    if not _G.TracerESP then return end
    local viewportSize = CurrentCamera.ViewportSize
    local bottomCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y)
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local tracer = root:FindFirstChild("TracerESP")
            if tracer then
                local line = tracer:FindFirstChild("Line")
                if line then
                    local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        -- Vector from player screen position to bottom center
                        local dir = bottomCenter - Vector2.new(screenPos.X, screenPos.Y)
                        local distance = dir.Magnitude
                        -- Clamp line length so it doesn't go off-screen
                        local maxLen = math.min(distance, 300)  -- cap at 300px
                        line.Size = UDim2.new(0, 2, 0, math.max(10, maxLen))  -- at least 10px
                        -- Angle: atan2 gives angle from positive X axis
                        local angle = math.deg(math.atan2(dir.Y, dir.X))
                        -- With anchor at top (0.5,0), the frame extends downward.
                        -- Setting rotation to angle rotates the downward direction to point toward bottom center.
                        line.Rotation = angle
                    else
                        -- If off-screen, hide the line by making it very short
                        line.Size = UDim2.new(0, 0, 0, 0)
                    end
                end
            end
        end
    end
end

