local skySection = tabs.Atmosphere:AddCollapsibleSection("Sky Presets", "lucide/cloud-sun", true)
local activeSkyToggle = nil

local function clearSky()
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Sky") then child:Destroy() end
    end
end

local function applySky(asset)
    clearSky()
    local sky = Instance.new("Sky")
    sky.Parent = Lighting
    sky.CelestialBodiesShown = false
    sky.SkyboxBk = asset
    sky.SkyboxDn = asset
    sky.SkyboxFt = asset
    sky.SkyboxLf = asset
    sky.SkyboxRt = asset
    sky.SkyboxUp = asset
end

local function createSkyToggle(name, asset)
    local toggle = skySection:AddToggle(name .. "SkyToggle", {
        Title = name,
        Default = false
    })
    toggle:OnChanged(function(v)
        if v then
            if activeSkyToggle and activeSkyToggle ~= toggle then
                activeSkyToggle:SetValue(false)
            end
            activeSkyToggle = toggle
            applySky(asset)
            Notify("Sky", name .. " applied", "Success", nil, 2)
        else
            if activeSkyToggle == toggle then
                clearSky()
                Notify("Sky", "Sky restored to default", "Info", nil, 2)
            end
        end
    end)
    return toggle
end

