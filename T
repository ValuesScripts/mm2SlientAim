-- Draggable logic for open button
do
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    local holding = false
    local holdToken = 0
    openButton:SetAttribute("Locked", false)

    local function update(input)
        if openButton:GetAttribute("Locked") then return end
        local delta = input.Position - dragStart
        openButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    openButton.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = not openButton:GetAttribute("Locked")
        holding = true
        dragStart = input.Position
        startPos = openButton.Position
        holdToken += 1
        local token = holdToken
        task.delay(1, function()
            if holding and token == holdToken then
                local newLock = not openButton:GetAttribute("Locked")
                openButton:SetAttribute("Locked", newLock)
            end
        end)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                holding = false
            end
        end)
    end)

    openButton.InputChanged:Connect(function(input)
        if not dragStart then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if (input.Position - dragStart).Magnitude > 6 then holding = false end
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)
end

