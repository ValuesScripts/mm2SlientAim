local function grabGun()
    local char = LocalPlayer.Character
    if not char then
        Notify("Grab Gun", "No character", "Error", nil, 2)
        return
    end

    local gun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("Pistol")
    if gun then
        Notify("Grab Gun", "You already have a gun!", "Warning", nil, 2)
        return
    end

    local foundGun = nil
    for gunObj, _ in pairs(droppedGuns) do
        if gunObj and gunObj.Parent then
            foundGun = gunObj
            break
        end
    end

    if not foundGun then
        Notify("Grab Gun", "No dropped gun found!", "Error", nil, 2)
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        foundGun:PivotTo(root.CFrame * CFrame.new(0, -0.5, 1))
        if foundGun:FindFirstChild("TouchInterest", true) or foundGun:FindFirstChildWhichIsA("TouchTransmitter", true) then
            firetouchinterest(root, foundGun, 0)
            task.wait(0.1)
            firetouchinterest(root, foundGun, 1)
            Notify("Grab Gun", "Grabbing gun...", "Info", nil, 2)
            
            task.wait(0.5)
            local newGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("Pistol")
            if newGun then
                Notify("Grab Gun", "Gun equipped!", "Success", nil, 2)
            else
                Notify("Grab Gun", "Try moving closer to the gun", "Warning", nil, 2)
            end
        end
    end
end

